<Window x:Class="KaraokeFilmMaker.App.Practice.PracticeRoomWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:controls="clr-namespace:KaraokeFilmMaker.App.Controls"
 Title="练歌房 · Liraoke" Width="1120" Height="800" MinWidth="860" MinHeight="620"
 WindowStartupLocation="CenterOwner" Background="#FAFCFD" Foreground="#34424D"
 FontFamily="Segoe UI" FontSize="13" Icon="/Liraoke;component/Assets/Liraoke.ico"
 Loaded="Window_Loaded" Closing="Window_Closing" Closed="Window_Closed" PreviewKeyDown="Window_KeyDown">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
  <ResourceDictionary Source="/Liraoke;component/Themes/LightTheme.xaml" />
 </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Grid Margin="18">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,12">
   <TextBlock x:Name="SongTitle" FontSize="21" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
   <TextBlock Text="练歌房 · 当前项目的播放副本 · 不保存录音" Foreground="#687782" Margin="0,4,0,0"/>
  </StackPanel>
  <Border Grid.Row="1" Background="#111820" CornerRadius="10" Padding="6">
   <Viewbox Stretch="Uniform">
    <Grid x:Name="Stage" Background="Black" ClipToBounds="True" Width="960" Height="540">
     <MediaElement x:Name="Video" LoadedBehavior="Manual" UnloadedBehavior="Close" IsMuted="True"
       Stretch="Uniform" MediaOpened="Video_Opened" MediaFailed="Video_Failed" Visibility="Hidden"/>
     <Image x:Name="Still" Stretch="UniformToFill" Visibility="Collapsed"/>
     <controls:AudioVisualizationOverlay x:Name="Visualization" IsHitTestVisible="False"/>
     <controls:SubtitleOverlay x:Name="Subtitles" IsHitTestVisible="False"/>
    </Grid>
   </Viewbox>
  </Border>
  <Grid Grid.Row="2" Margin="0,12,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <Button x:Name="PlayButton" Content="播放" Click="Play_Click" Padding="22,8" Margin="0,0,10,0" IsEnabled="False"/>
   <Slider x:Name="PositionSlider" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1"
     IsEnabled="False" PreviewMouseLeftButtonDown="Seek_Begin" PreviewMouseLeftButtonUp="Seek_End" KeyUp="Seek_KeyUp"/>
   <TextBlock x:Name="TimeText" Grid.Column="2" Text="00:00 / 00:00" VerticalAlignment="Center" Margin="12,0,0,0"/>
  </Grid>
  <Border Grid.Row="3" Background="#F0F9FC" BorderBrush="#D4E8F0" BorderThickness="1" CornerRadius="8" Padding="12">
   <StackPanel x:Name="SettingsPanel">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,12,0"><TextBlock Text="麦克风"/><ComboBox x:Name="InputDevice" DisplayMemberPath="Name" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="输出设备"/><ComboBox x:Name="OutputDevice" DisplayMemberPath="Name" Margin="0,5,0,0"/></StackPanel>
     <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="播放版本"/>
      <ComboBox x:Name="VersionCombo" SelectedIndex="0" Margin="0,5,0,0"><ComboBoxItem Content="原唱"/><ComboBoxItem x:Name="AccompanimentItem" Content="伴奏"/></ComboBox>
     </StackPanel>
     <Button Grid.Column="3" x:Name="ConnectButton" Content="连接 / 应用" Click="Connect_Click" VerticalAlignment="Bottom" Padding="12,7"/>
    </Grid>
    <Grid Margin="0,14,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="歌曲音量" VerticalAlignment="Center"/>
     <Slider x:Name="SongVolume" Grid.Column="1" Minimum="0" Maximum="1" Value="0.7" Margin="10,0,20,0" ValueChanged="Volume_Changed"/>
     <TextBlock Grid.Column="2" Text="麦克风音量" VerticalAlignment="Center"/>
     <Slider x:Name="MicVolume" Grid.Column="3" Minimum="0" Maximum="1" Value="0.7" Margin="10,0,20,0" ValueChanged="Volume_Changed"/>
     <CheckBox x:Name="MonitorCheck" Grid.Column="4" Content="开启监听" Click="Monitor_Click" VerticalAlignment="Center" Margin="0,0,14,0"/>
     <CheckBox x:Name="MuteCheck" Grid.Column="5" Content="麦克风静音" Click="Volume_Changed" VerticalAlignment="Center"/>
    </Grid>
    <TextBlock Text="建议使用有线耳机监听；歌曲暂停时仍可试麦。选择设备或版本后点击“连接 / 应用”。" Foreground="#687782" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <TextBlock x:Name="Status" Grid.Row="4" Text="正在准备练歌房…" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#527086"/>
 </Grid>
</Window>
