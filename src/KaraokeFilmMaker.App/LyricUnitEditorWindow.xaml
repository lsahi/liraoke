<Window x:Class="KaraokeFilmMaker.App.LyricUnitEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="演唱单元编辑" Width="960" Height="560" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock x:Name="LineText" FontSize="22" TextWrapping="Wrap" Margin="0,0,0,10" />
    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
      <Button Padding="12,7" Margin="0,0,8,0" Click="MergeButton_Click" Content="合并选中单元" />
      <Button Padding="12,7" Margin="0,0,8,0" Click="SplitButton_Click" Content="按音节 / 单词拆分" />
      <Button Padding="12,7" Margin="0,0,8,0" Click="MoveUnitUpButton_Click" Content="前移单元" />
      <Button Padding="12,7" Margin="0,0,8,0" Click="MoveUnitDownButton_Click" Content="后移单元" />
      <TextBlock VerticalAlignment="Center" Text="双击“对应歌词”修改映射；相同文字用范围定位（从 1 开始）；不改原文或打点时间。" TextWrapping="Wrap" />
    </WrapPanel>
    <DataGrid x:Name="UnitsGrid" Grid.Row="2" AutoGenerateColumns="False"
              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
              SelectionMode="Extended" SelectionUnit="FullRow">
      <DataGrid.Resources>
        <Style TargetType="TextBox">
          <Style.Triggers>
            <Trigger Property="Validation.HasError" Value="True">
              <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </DataGrid.Resources>
      <DataGrid.Columns>
        <DataGridTextColumn Header="对应歌词" Binding="{Binding DisplayText, Mode=TwoWay, ValidatesOnExceptions=True}" Width="*" MinWidth="88" />
        <DataGridTextColumn Header="文字范围" Binding="{Binding MappingText, Mode=TwoWay, ValidatesOnExceptions=True}" Width="110" />
        <DataGridTextColumn Header="读音" Binding="{Binding Reading}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="罗马音" Binding="{Binding Romanization}" Width="*" MinWidth="80" />
        <DataGridTextColumn Header="开始（秒）" Binding="{Binding StartSeconds}" Width="110" />
        <DataGridTextColumn Header="结束（秒）" Binding="{Binding EndSeconds}" Width="110" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Padding="20,8" Margin="0,0,8,0" Click="ConfirmButton_Click" Content="应用并关闭" />
      <Button Padding="20,8" IsCancel="True" Content="取消" />
    </StackPanel>
  </Grid>
</Window>
