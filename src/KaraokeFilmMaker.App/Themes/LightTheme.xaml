<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Keep the working canvas neutral; brand colours are quiet borders and small accents. -->
    <SolidColorBrush x:Key="LiraInk" Color="#34424D" />
    <SolidColorBrush x:Key="LiraMutedInk" Color="#687782" />
    <SolidColorBrush x:Key="LiraLine" Color="#DDE6EA" />
    <SolidColorBrush x:Key="LiraBlue" Color="#F2FAFD" />
    <SolidColorBrush x:Key="LiraYellow" Color="#FFFDF5" />
    <Style x:Key="LiraButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="#C9DDE6" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#F0F9FC" /><Setter TargetName="Chrome" Property="BorderBrush" Value="#96C6D7" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#4A99B8" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#DFEFF5" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource LiraButtonStyle}" />
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="#CCDCE4" />
        <Setter Property="Padding" Value="7,5" />
        <Setter Property="CaretBrush" Value="{StaticResource LiraInk}" />
        <Setter Property="SelectionBrush" Value="#B5DDEB" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="#CCDCE4" /><Setter Property="Padding" Value="7,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiraLine}" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="5,3" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="ItemChrome" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#F7FBFD" /></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemChrome" Property="Background" Value="#ECF7FB" /><Setter TargetName="ItemChrome" Property="BorderBrush" Value="#A6CEDD" /></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiraLine}" /><Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="White" /><Setter Property="AlternatingRowBackground" Value="#FBFDFE" />
        <Setter Property="HorizontalGridLinesBrush" Value="#EDF2F5" /><Setter Property="VerticalGridLinesBrush" Value="#EDF2F5" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#F6FAFC" /><Setter Property="Foreground" Value="#5E7380" />
        <Setter Property="Padding" Value="10,9" /><Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderBrush" Value="#E4EDF1" /><Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="Padding" Value="3" />
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF6FB" /><Setter Property="Foreground" Value="#274C60" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="{StaticResource LiraInk}" />
        <Setter Property="BorderBrush" Value="{StaticResource LiraLine}" />
    </Style>
    <Style TargetType="ProgressBar">
        <Setter Property="Foreground" Value="#97CBDD" /><Setter Property="Background" Value="#F2F7F9" />
        <Setter Property="BorderBrush" Value="#E1EBEF" />
    </Style>
</ResourceDictionary>
