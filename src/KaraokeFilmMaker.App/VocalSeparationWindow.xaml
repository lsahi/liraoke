<Window x:Class="KaraokeFilmMaker.App.VocalSeparationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="制作伴奏" Width="650" Height="600" MinWidth="600" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#FAFCFD" Foreground="#34424D"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing" Loaded="Window_Loaded">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/LightTheme.xaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <Grid Margin="22" Background="#FAFCFD">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="制作伴奏" FontSize="23" FontWeight="SemiBold" />
            <TextBlock x:Name="SongText" Margin="0,8,0,6" TextWrapping="Wrap" />
            <TextBlock Text="本机离线处理 · 不上传歌曲 · 不覆盖原文件 · 保留歌词打轴" Foreground="#687782" TextWrapping="Wrap" />
            <Border Background="White" BorderBrush="#DDEBF1" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,18,0,12">
                <StackPanel>
                    <TextBlock Text="GPU 加速（可选）" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="GpuText" Text="正在检测显卡…" TextWrapping="Wrap" Margin="0,8,0,8" />
                    <WrapPanel>
                        <Button x:Name="InstallGpuButton" Content="下载并启用 GPU 加速" IsEnabled="False" Click="InstallGpu_Click" Margin="0,0,8,8" ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="DetectButton" Content="重新检测" Click="Detect_Click" Margin="0,0,8,8" />
                        <Button x:Name="UninstallButton" Content="卸载 GPU 组件" IsEnabled="False" Click="Uninstall_Click" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock x:Name="RuntimeText" TextWrapping="Wrap" Foreground="#687782" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button Content="CUDA 许可" Click="Licenses_Click" Padding="8,4" Margin="0,0,8,0" />
                        <Button Content="cuDNN 许可" Click="CudnnLicense_Click" Padding="8,4" Margin="0,0,8,0" />
                        <Button Content="NVIDIA 驱动官网" Click="Driver_Click" Padding="8,4" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Grid x:Name="OptionsPanel" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="处理引擎" VerticalAlignment="Center" />
                <ComboBox x:Name="EngineCombo" Grid.Column="1" SelectedIndex="0" Margin="0,0,0,10">
                    <ComboBoxItem Content="CPU · 默认兼容模式" />
                    <ComboBoxItem x:Name="GpuEngineItem" Content="GPU · NVIDIA 加速" IsEnabled="False" />
                </ComboBox>
                <TextBlock Grid.Row="1" Text="生成内容" VerticalAlignment="Center" />
                <ComboBox x:Name="OutputCombo" Grid.Row="1" Grid.Column="1" SelectedIndex="0">
                    <ComboBoxItem Content="伴奏 A · 合成非人声分轨（推荐）" />
                    <ComboBoxItem Content="伴奏 B · 从原曲减去人声" />
                </ComboBox>
            </Grid>
            <TextBlock Text="伴奏与原歌曲自动关联，不加入素材列表。完成后可在预览右侧开关伴奏，导出时单独选择版本。最长 30 分钟。" Foreground="#687782" TextWrapping="Wrap" />
            <ProgressBar x:Name="TaskProgress" Height="6" Margin="0,18,0,8" Minimum="0" Maximum="1" />
            <TextBlock x:Name="TaskText" Text="就绪" TextWrapping="Wrap" MinHeight="48" />
        </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelTaskButton" Content="取消任务" IsEnabled="False" Click="CancelTask_Click" Margin="0,0,8,0" />
            <Button x:Name="GenerateButton" Content="开始生成" IsEnabled="False" Click="Generate_Click" Background="#FFFDF5" Margin="0,0,8,0" />
            <Button Content="关闭" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
